        "class Attention(Layer):\n",
        "    def __init__(self, **kwargs):\n",
        "        super(Attention, self).__init__(**kwargs)\n",
        "\n",
        "    def build(self, input_shape):\n",
        "        # input_shape = (batch, timesteps, features)\n",
        "        self.W = self.add_weight(\n",
        "            name='att_weight',\n",
        "            shape=(input_shape[-1], 1),\n",
        "            initializer='glorot_uniform',\n",
        "            trainable=True\n",
        "        )\n",
        "        self.b = self.add_weight(\n",
        "            name='att_bias',\n",
        "            shape=(input_shape[1], 1),  # (timesteps, 1)\n",
        "            initializer='zeros',\n",
        "            trainable=True\n",
        "        )\n",
        "        super(Attention, self).build(input_shape)\n",
        "\n",
        "    def call(self, x):\n",
        "        # x: (batch, T, d)\n",
        "        e = K.tanh(K.dot(x, self.W) + self.b)  # (batch, T, 1)\n",
        "        e = K.squeeze(e, axis=-1)              # (batch, T)\n",
        "\n",
        "        alpha = K.softmax(e)                   # веса attention, (batch, T)\n",
        "\n",
        "        alpha_expanded = K.expand_dims(alpha, axis=-1)  # (batch, T, 1)\n",
        "        context = x * alpha_expanded                   # (batch, T, d)\n",
        "        context = K.sum(context, axis=1)               # (batch, d)\n",
        "        return context\n",
        "\n",
        "    def compute_output_shape(self, input_shape):\n",
        "        # (batch, features)\n",
        "        return (input_shape[0], input_shape[-1])\n"
